# AutoParts ERP configuration. Copy to `.env` (never commit `.env`).
# All values below are examples — generate your own secrets.

NODE_ENV=development            # development | production
PORT=4000
# MongoDB MUST be a replica set (multi-document transactions). `npm run dev:db` starts one on 27018.
MONGODB_URI=mongodb://127.0.0.1:27018/autoparts_erp?replicaSet=rs0
# Browser origins allowed to call the API (comma separated). In production the API also serves the web app.
CORS_ORIGINS=http://localhost:5173

# 32+ random bytes, hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-value
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
COOKIE_SECURE=false             # set true in production behind HTTPS
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=600

UPLOAD_DIR=./uploads            # public images (product photos, logo); expense receipts go to ./uploads-private
BACKUP_DIR=./backups
# 64 hex characters (32 bytes). Required for backups. KEEP A COPY OFFLINE — backups cannot be decrypted without it.
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_COUNT=14
BACKUP_SCHEDULE_HOURS=24        # 0 disables scheduled backups
JOBS_ENABLED=true               # alert checks + scheduled backups

LOG_LEVEL=info

# Optional AI narrative for monthly reports. The ERP works fully without it.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Used only by `npm run init-admin` for non-interactive setup (otherwise you are prompted).
INIT_ADMIN_USERNAME=
INIT_ADMIN_FULLNAME=
INIT_ADMIN_PASSWORD=
INIT_ADMIN_EMAIL=
